{
	"name": "wiki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"volta": {
		"node": "25.9.0",
		"pnpm": "11.10.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "25.9.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"generate:runtime": "node scripts/generate-runtime-metadata.mjs",
		"dev": "pnpm generate:runtime && vite dev",
		"build": "pnpm generate:runtime && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"audit:prelive": "node scripts/audit-prelive.mjs",
		"audit:prelive:crawl": "node scripts/audit-prelive.mjs --crawl-built",
		"check": "pnpm generate:runtime && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "pnpm generate:runtime && vitest run",
		"test:unit": "pnpm generate:runtime && vitest run",
		"test:unit:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"sass-embedded": "^1.100.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	}
}
